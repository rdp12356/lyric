{
  "name": "lyric",
  "version": "1.0.0",
  "description": "Open-source ambient rim lighting and kinetic synchronized lyrics for Spotify and Apple Music.",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "server": "node server/index.js",
    "start": "concurrently \"npm run server\" \"npm run dev\"",
    "electron:dev": "concurrently \"node server/index.js\" \"vite\" \"electron electron/main.cjs\"",
    "package:mac": "npm run build && electron-builder --mac --dir",
    "package:win": "npm run build && electron-builder --win zip",
    "build:dmg": "npm run build && electron-builder --mac dmg",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleLocalDebug",
    "test:android-ui": "node tests/sync-audio.cjs && node tests/android-smoke.cjs && node tests/android-media-smoke.cjs && node tests/spotify-reconnect-smoke.cjs && node tests/spotify-event-sync-smoke.cjs && node tests/android-ux-smoke.cjs",
    "test:sync": "node tests/sync-audio.cjs"
  },
  "build": {
    "appId": "xyz.lyric.app",
    "productName": "Lyric",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "server/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "win": {
      "target": [
        "zip"
      ],
      "signAndEditExecutable": false
    }
  },
  "keywords": [
    "lumen",
    "trylumen",
    "verci",
    "ambient-lighting",
    "lyrics",
    "lrclib",
    "spotify",
    "apple-music",
    "lockscreen"
  ],
  "author": "Lyric Contributors",
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/core": "^7.6.10",
    "@emotion/is-prop-valid": "^1.4.0",
    "@ybouane/liquidglass": "^1.0.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "framer-motion": "^12.4.7",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.10",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.0.9",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
